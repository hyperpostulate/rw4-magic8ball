<template>
  <div class="app" @click="onTap" @touchstart="onTap">
    <image class="title" src="{{ titleSrc }}"></image>
    <image class="face" src="{{ faceSrc }}"></image>
    <image class="hint" src="{{ hintSrc }}"></image>
  </div>
</template>

<script>
// Magic 8 Ball for the Redmi Watch 4 (Vela quick app).
//
// Device constraints that shape this file:
//   - <text>/<span>/<input> paint no readable glyphs on this watch, so every visible
//     string is a pre-rendered PNG generated by scripts/gen_assets.py. The card face
//     (fill + 2px edge + answer text) is baked into ONE image, so a state change is a
//     single src swap on one node. Three <image> nodes total: title, face, hint.
//   - Tap delivery is not verified on this device, so both @click and @touchstart are
//     bound to the same handler; a 350ms guard swallows the duplicate if both fire.
//   - Layout is flex-direction + margin/padding only (no display/gap/position), and the
//     curved screen crops the corners: content stops at y=398 of the 390x450 canvas.
//   - Assets are named with a content stamp (see the generated block below) because the
//     watch caches images by path across installs.

import vibrator from '@system.vibrator'

// __ASSETS_BEGIN__ generated by scripts/gen_assets.py - do not edit by hand
// stamp: 81d7cf41 (content hash; changes whenever copy/geometry changes)
// version: 1.0.0
const TITLE_SRC = '/common/txt/title_81d7cf41.png'
const HINT_ASK_SRC = '/common/txt/hint_ask_81d7cf41.png'
const HINT_AGAIN_SRC = '/common/txt/hint_again_81d7cf41.png'
const FACE_IDLE = '/common/face/idle_81d7cf41.png'
const FACE_ROLL = [
  '/common/face/roll0_81d7cf41.png',
  '/common/face/roll1_81d7cf41.png',
  '/common/face/roll2_81d7cf41.png',
  '/common/face/roll3_81d7cf41.png',
  '/common/face/roll4_81d7cf41.png',
  '/common/face/roll5_81d7cf41.png'
]
const FACE_ANS = [
  '/common/face/ans00_81d7cf41.png',
  '/common/face/ans01_81d7cf41.png',
  '/common/face/ans02_81d7cf41.png',
  '/common/face/ans03_81d7cf41.png',
  '/common/face/ans04_81d7cf41.png',
  '/common/face/ans05_81d7cf41.png',
  '/common/face/ans06_81d7cf41.png',
  '/common/face/ans07_81d7cf41.png',
  '/common/face/ans08_81d7cf41.png',
  '/common/face/ans09_81d7cf41.png',
  '/common/face/ans10_81d7cf41.png',
  '/common/face/ans11_81d7cf41.png',
  '/common/face/ans12_81d7cf41.png',
  '/common/face/ans13_81d7cf41.png',
  '/common/face/ans14_81d7cf41.png',
  '/common/face/ans15_81d7cf41.png',
  '/common/face/ans16_81d7cf41.png',
  '/common/face/ans17_81d7cf41.png',
  '/common/face/ans18_81d7cf41.png',
  '/common/face/ans19_81d7cf41.png'
]
// __ASSETS_END__

const ROLL_MS = 600      // total spin before the answer settles
const FRAME_MS = 100     // spinner frame interval (6 frames = 600ms)
const GUARD_MS = 350     // swallow click+touchstart double delivery / double taps

function buzz(mode) {
  try {
    vibrator.vibrate({ mode: mode })
  } catch (e) {
    // vibration is best effort; never let it break the flow
  }
}

export default {
  private: {
    titleSrc: TITLE_SRC,
    hintSrc: HINT_ASK_SRC,
    faceSrc: FACE_IDLE
  },

  onInit() {
    this._frameTimer = null
    this._settleTimer = null
    this._busy = false
    this._lastTap = 0
    this._frame = 0
  },

  onShow() {
    // Opening (or returning to) the app always lands on idle.
    this._clearTimers()
    this._busy = false
    this._frame = 0
    this.faceSrc = FACE_IDLE
    this.hintSrc = HINT_ASK_SRC
  },

  onHide() {
    this._clearTimers()
  },

  onDestroy() {
    this._clearTimers()
  },

  _clearTimers() {
    if (this._frameTimer) {
      clearInterval(this._frameTimer)
      this._frameTimer = null
    }
    if (this._settleTimer) {
      clearTimeout(this._settleTimer)
      this._settleTimer = null
    }
  },

  onTap() {
    const now = Date.now()
    if (now - this._lastTap < GUARD_MS) {
      return
    }
    this._lastTap = now
    if (this._busy) {
      return
    }

    this._busy = true
    this.hintSrc = HINT_ASK_SRC
    buzz('short')

    // Spin: cycle the six pre-rendered spinner faces.
    this._frame = 0
    this.faceSrc = FACE_ROLL[0]
    this._frameTimer = setInterval(() => {
      this._frame = (this._frame + 1) % FACE_ROLL.length
      this.faceSrc = FACE_ROLL[this._frame]
    }, FRAME_MS)

    this._settleTimer = setTimeout(() => this._settle(), ROLL_MS)
  },

  _settle() {
    if (this._frameTimer) {
      clearInterval(this._frameTimer)
      this._frameTimer = null
    }
    this._settleTimer = null

    const i = Math.floor(Math.random() * FACE_ANS.length)
    this.faceSrc = FACE_ANS[i]
    this.hintSrc = HINT_AGAIN_SRC
    this._busy = false
    buzz('long')
  }
}
</script>

<style>
/* Geometry is fixed and matches docs/design.md exactly: title 34..68,
   card 86..366, hint 374..398 on the 390x450 canvas. */
.app {
  width: 390px;
  height: 450px;
  flex-direction: column;
  align-items: center;
  justify-content: flex-start;
  padding-top: 34px;
  background-color: #000000;
}

.title {
  width: 320px;
  height: 34px;
  margin-bottom: 18px;
}

.face {
  width: 310px;
  height: 280px;
  margin-bottom: 8px;
}

.hint {
  width: 320px;
  height: 24px;
}
</style>
