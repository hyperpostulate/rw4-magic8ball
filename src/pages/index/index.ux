<template>
  <div class="app" @click="onTap" @touchstart="onTap">
    <image class="title" src="{{ titleSrc }}"></image>
    <image class="face" src="{{ faceSrc }}"></image>
    <image class="hint" src="{{ hintSrc }}"></image>
  </div>
</template>

<script>
// Magic 8 Ball for the Redmi Watch 4 (Vela quick app).
//
// Device constraints that shape this file:
//   - <text>/<span>/<input> paint no readable glyphs on this watch, so every visible
//     string is a pre-rendered PNG generated by scripts/gen_assets.py. The card face
//     (fill + 2px edge + answer text) is baked into ONE image, so a state change is a
//     single src swap on one node. Three <image> nodes total: title, face, hint.
//   - Tap input is verified working on device, but which event the runtime emits
//     (@click vs @touchstart) was never isolated, so both are bound to the same
//     handler behind a short guard that also swallows duplicate delivery.
//   - Layout is flex-direction + margin/padding only (no display/gap/position), and the
//     curved screen crops the corners: content stops at y=398 of the 390x450 canvas.
//   - Assets are named with a content stamp (see the generated block below) because the
//     watch caches images by path across installs.

import vibrator from '@system.vibrator'

// __ASSETS_BEGIN__ generated by scripts/gen_assets.py - do not edit by hand
// stamp: 8cf8d9c6 (content hash; changes whenever copy/geometry changes)
// version: 1.1.0
// LOCALE is rewritten by scripts/build.py for each .rpk; both asset sets ship.
const LOCALE = 'en'
const TITLE_SRC = '/common/txt/title_8cf8d9c6.png'
const COPY = {
  en: {
    hintAsk: '/common/txt/en/hint_ask_8cf8d9c6.png',
    hintAgain: '/common/txt/en/hint_again_8cf8d9c6.png',
    idle: '/common/face/en/idle_8cf8d9c6.png',
    roll: [
      '/common/face/en/roll0_8cf8d9c6.png',
      '/common/face/en/roll1_8cf8d9c6.png',
      '/common/face/en/roll2_8cf8d9c6.png',
      '/common/face/en/roll3_8cf8d9c6.png',
      '/common/face/en/roll4_8cf8d9c6.png',
      '/common/face/en/roll5_8cf8d9c6.png'
    ],
    ans: [
      '/common/face/en/ans00_8cf8d9c6.png',
      '/common/face/en/ans01_8cf8d9c6.png',
      '/common/face/en/ans02_8cf8d9c6.png',
      '/common/face/en/ans03_8cf8d9c6.png',
      '/common/face/en/ans04_8cf8d9c6.png',
      '/common/face/en/ans05_8cf8d9c6.png',
      '/common/face/en/ans06_8cf8d9c6.png',
      '/common/face/en/ans07_8cf8d9c6.png',
      '/common/face/en/ans08_8cf8d9c6.png',
      '/common/face/en/ans09_8cf8d9c6.png',
      '/common/face/en/ans10_8cf8d9c6.png',
      '/common/face/en/ans11_8cf8d9c6.png',
      '/common/face/en/ans12_8cf8d9c6.png',
      '/common/face/en/ans13_8cf8d9c6.png',
      '/common/face/en/ans14_8cf8d9c6.png',
      '/common/face/en/ans15_8cf8d9c6.png',
      '/common/face/en/ans16_8cf8d9c6.png',
      '/common/face/en/ans17_8cf8d9c6.png',
      '/common/face/en/ans18_8cf8d9c6.png',
      '/common/face/en/ans19_8cf8d9c6.png'
    ]
  },
  tr: {
    hintAsk: '/common/txt/tr/hint_ask_8cf8d9c6.png',
    hintAgain: '/common/txt/tr/hint_again_8cf8d9c6.png',
    idle: '/common/face/tr/idle_8cf8d9c6.png',
    roll: [
      '/common/face/tr/roll0_8cf8d9c6.png',
      '/common/face/tr/roll1_8cf8d9c6.png',
      '/common/face/tr/roll2_8cf8d9c6.png',
      '/common/face/tr/roll3_8cf8d9c6.png',
      '/common/face/tr/roll4_8cf8d9c6.png',
      '/common/face/tr/roll5_8cf8d9c6.png'
    ],
    ans: [
      '/common/face/tr/ans00_8cf8d9c6.png',
      '/common/face/tr/ans01_8cf8d9c6.png',
      '/common/face/tr/ans02_8cf8d9c6.png',
      '/common/face/tr/ans03_8cf8d9c6.png',
      '/common/face/tr/ans04_8cf8d9c6.png',
      '/common/face/tr/ans05_8cf8d9c6.png',
      '/common/face/tr/ans06_8cf8d9c6.png',
      '/common/face/tr/ans07_8cf8d9c6.png',
      '/common/face/tr/ans08_8cf8d9c6.png',
      '/common/face/tr/ans09_8cf8d9c6.png',
      '/common/face/tr/ans10_8cf8d9c6.png',
      '/common/face/tr/ans11_8cf8d9c6.png',
      '/common/face/tr/ans12_8cf8d9c6.png',
      '/common/face/tr/ans13_8cf8d9c6.png',
      '/common/face/tr/ans14_8cf8d9c6.png',
      '/common/face/tr/ans15_8cf8d9c6.png',
      '/common/face/tr/ans16_8cf8d9c6.png',
      '/common/face/tr/ans17_8cf8d9c6.png',
      '/common/face/tr/ans18_8cf8d9c6.png',
      '/common/face/tr/ans19_8cf8d9c6.png'
    ]
  }
}
// __ASSETS_END__

const ROLL_MS = 600      // total spin before the answer settles
const FRAME_MS = 100     // spinner frame interval (6 frames = 600ms)
const GUARD_MS = 350     // swallow click+touchstart double delivery / double taps

function buzz(mode) {
  // Verified working on device for both modes; guarded so a firmware regression
  // can never break the visual flow.
  try {
    vibrator.vibrate({ mode: mode })
  } catch (e) {
    // ignore
  }
}

// String and image lookups for the active language (LOCALE comes from the
// generated block; scripts/build.py flips it per .rpk).
const T = COPY[LOCALE]

export default {
  private: {
    titleSrc: TITLE_SRC,
    hintSrc: T.hintAsk,
    faceSrc: T.idle
  },

  onInit() {
    this._frameTimer = null
    this._settleTimer = null
    this._busy = false
    this._lastTap = 0
    this._frame = 0
  },

  onShow() {
    // Opening (or returning to) the app always lands on idle.
    this._clearTimers()
    this._busy = false
    this._frame = 0
    this.faceSrc = T.idle
    this.hintSrc = T.hintAsk
  },

  onHide() {
    this._clearTimers()
  },

  onDestroy() {
    this._clearTimers()
  },

  _clearTimers() {
    if (this._frameTimer) {
      clearInterval(this._frameTimer)
      this._frameTimer = null
    }
    if (this._settleTimer) {
      clearTimeout(this._settleTimer)
      this._settleTimer = null
    }
  },

  onTap() {
    const now = Date.now()
    if (now - this._lastTap < GUARD_MS) {
      return
    }
    this._lastTap = now
    if (this._busy) {
      return
    }

    this._busy = true
    this.hintSrc = T.hintAsk
    buzz('short')

    // Spin: cycle the six pre-rendered spinner faces.
    this._frame = 0
    this.faceSrc = T.roll[0]
    this._frameTimer = setInterval(() => {
      this._frame = (this._frame + 1) % T.roll.length
      this.faceSrc = T.roll[this._frame]
    }, FRAME_MS)

    this._settleTimer = setTimeout(() => this._settle(), ROLL_MS)
  },

  _settle() {
    if (this._frameTimer) {
      clearInterval(this._frameTimer)
      this._frameTimer = null
    }
    this._settleTimer = null

    const i = Math.floor(Math.random() * T.ans.length)
    this.faceSrc = T.ans[i]
    this.hintSrc = T.hintAgain
    this._busy = false
    buzz('long')
  }
}
</script>

<style>
/* Geometry is fixed and matches docs/design.md exactly: title 34..68,
   card 86..366, hint 374..398 on the 390x450 canvas. */
.app {
  width: 390px;
  height: 450px;
  flex-direction: column;
  align-items: center;
  justify-content: flex-start;
  padding-top: 34px;
  background-color: #000000;
}

.title {
  width: 320px;
  height: 34px;
  margin-bottom: 18px;
}

.face {
  width: 310px;
  height: 280px;
  margin-bottom: 8px;
}

.hint {
  width: 320px;
  height: 24px;
}
</style>
