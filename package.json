{
  "name": "rw4-magic8ball",
  "version": "1.1.0",
  "private": true,
  "description": "Magic 8 Ball for the Redmi Watch 4 as a Xiaomi Vela quick app; every visible pixel is a pre-rendered PNG because the runtime draws no text.",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "start": "aiot start --watch",
    "build": "python3 scripts/build.py",
    "build:en": "python3 scripts/build.py en",
    "build:tr": "python3 scripts/build.py tr",
    "release": "aiot release"
  },
  "devDependencies": {
    "@aiot-toolkit/jsc": "^1.0.3",
    "aiot-toolkit": "^2.0.5"
  }
}
